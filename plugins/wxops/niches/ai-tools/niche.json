  },
  "pain_points": {
    "names": [
      "账号安全与权限焦虑",
      "成本、额度与订阅压力",
      "工具选择与效率落地",
      "模型能力判断",
      "副业产品化与变现",
      "热点信息差与谈资"
    ],
    "by_content_type": {
      "风险/账号/额度焦虑": "账号安全与权限焦虑",
      "价格/额度/羊毛情报": "成本、额度与订阅压力",
      "AI 编程/Agent 工作流": "工具选择与效率落地",
      "模型发布/能力解读": "模型能力判断",
      "产品/副业/商业化": "副业产品化与变现"
    },
    "term_rules": [
      {
        "terms": ["免费", "价格", "额度", "订阅"],
        "pain": "成本、额度与订阅压力"
      }
    ],
    "default": "热点信息差与谈资"
  },
  "personas": {
    "names": [
      "Claude/Codex/GPT 重度用户",
      "AI 编程/Agent 实践者",
      "省钱党与套餐比较用户",
      "产品经理/独立开发者",
      "非技术效率工具用户",
      "AI 新闻观察者"
    ],
    "rules": [
      {
        "if": {
          "terms_any": ["codex", "claude", "gpt", "openai", "anthropic", "kimi"],
          "content_type": "AI 编程/Agent 工作流"
        },
        "then": "AI 编程/Agent 实践者"
      },
      {
        "if": {
          "terms_any": ["codex", "claude", "gpt", "openai", "anthropic", "kimi"]
        },
        "then": "Claude/Codex/GPT 重度用户"
      },
      {
        "if": {
          "pain": "成本、额度与订阅压力"
        },
        "then": "省钱党与套餐比较用户"
      },
      {
        "if": {
          "content_type": "产品/副业/商业化"
        },
        "then": "产品经理/独立开发者"
      },
      {
        "if": {
          "content_type": "泛 AI 热点/效率工具"
        },
        "then": "非技术效率工具用户"
      }
    ],
    "default": "AI 新闻观察者"
  },
  "title_patterns": {
    "keys": [
      "风险损失型",
      "价格福利型",
      "模型发布型",
      "对比替代型",
      "教程清单型",
      "疑问反常识型",
      "工作流案例型",
      "普通资讯型"
    ],
    "slots": {
      "risk": {
        "label": "风险损失型",
        "terms": ["封号", "废掉", "限制", "卡", "缩水", "失效", "崩", "风险", "截止", "焦虑"]
      },
      "price": {
        "label": "价格福利型",
        "terms": ["免费", "额度", "价格", "会员", "订阅", "美金", "元", "羊毛"]
      },
      "release": {
        "label": "模型发布型",
        "subject_terms": ["glm", "kimi", "deepseek", "claude", "gpt", "minimax", "qwen", "模型"],
        "action_terms": ["发布", "开源", "上线", "新", "更新", "拿下"]
      },
      "workflow": {
        "label": "工作流案例型",
        "terms": ["codex", "claude code", "agent", "skill", "工作流", "github", "插件", "项目"]
      }
    }
  }
}
