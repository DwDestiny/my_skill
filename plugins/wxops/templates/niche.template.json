{
  "niche_schema_version": 1,
  "id": "my-niche",
  "name": "示例赛道（母婴育儿）",
  "description": "本文件是 niche 包模板：复制为 ~/.wxops/niches/<你的id>/niche.json，把 id 改成目录名，再整包替换词表与名单。字段含义与校验规则见插件内 references/niche-contract.md。下方以母婴赛道为例示范填法。",
  "content_types": {
    "names": [
      "安全与健康焦虑",
      "花钱与优惠情报",
      "新品与测评解读",
      "育儿方法与实操",
      "综合育儿资讯"
    ],
    "rules": [
      { "type": "安全与健康焦虑", "terms": ["召回", "安全隐患", "过敏", "添加剂", "烫伤", "误食"] },
      { "type": "花钱与优惠情报", "terms": ["优惠", "折扣", "平替", "省钱", "羊毛", "价格", "团购"] },
      { "type": "育儿方法与实操", "terms": ["辅食", "睡眠训练", "早教", "步骤", "实操", "亲测"] },
      { "type": "新品与测评解读", "terms": ["新品", "测评", "上市", "开箱", "对比评测"] }
    ],
    "fallback": {
      "type": "综合育儿资讯"
    }
  },
  "pain_points": {
    "names": [
      "宝宝安全焦虑",
      "养娃成本压力",
      "选品决策困难",
      "育儿方法不确定",
      "信息差与谈资"
    ],
    "by_content_type": {
      "安全与健康焦虑": "宝宝安全焦虑",
      "花钱与优惠情报": "养娃成本压力",
      "新品与测评解读": "选品决策困难",
      "育儿方法与实操": "育儿方法不确定"
    },
    "term_rules": [
      { "terms": ["贵", "值不值", "预算"], "pain": "养娃成本压力" }
    ],
    "default": "信息差与谈资"
  },
  "personas": {
    "names": [
      "新手爸妈",
      "精打细算型家长",
      "科学育儿实践者",
      "泛育儿关注者"
    ],
    "rules": [
      { "if": { "terms_any": ["新生儿", "月子", "第一次"], "content_type": "育儿方法与实操" }, "then": "科学育儿实践者" },
      { "if": { "terms_any": ["新生儿", "月子", "第一次"] }, "then": "新手爸妈" },
      { "if": { "pain": "养娃成本压力" }, "then": "精打细算型家长" }
    ],
    "default": "泛育儿关注者"
  },
  "title_patterns": {
    "keys": [
      "安全警示型",
      "省钱福利型",
      "新品上市型",
      "实操方法型",
      "对比替代型",
      "教程清单型",
      "疑问反常识型",
      "普通资讯型"
    ],
    "slots": {
      "risk": { "label": "安全警示型", "terms": ["召回", "隐患", "千万别", "危险", "过敏"] },
      "price": { "label": "省钱福利型", "terms": ["优惠", "折扣", "平替", "省", "免费"] },
      "release": {
        "label": "新品上市型",
        "subject_terms": ["奶粉", "纸尿裤", "安全座椅", "辅食机"],
        "action_terms": ["上市", "新品", "发布", "上新", "开售"]
      },
      "workflow": { "label": "实操方法型", "terms": ["辅食", "睡眠训练", "早教", "亲测", "实操"] }
    }
  }
}
