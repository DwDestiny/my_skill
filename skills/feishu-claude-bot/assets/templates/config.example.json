{
  "name": "小助理",
  "owner_name": "张三",
  "owner_open_id": "ou_主人的open_id（scripts/ids.sh 查）",
  "bot_open_id": "ou_机器人的open_id（scripts/ids.sh 查）",
  "channels": {
    "feishu": {
      "enabled": true
    },
    "wecom": {
      "enabled": false,
      "owner_userid": "主人的企微 userid（启用后主人私聊机器人一句，在日志 recv 行里看）",
      "credentials": "wecom-cli"
    }
  },
  "cross_im_read": false,
  "tasks": {
    "enabled": true,
    "root": "~/work/.bot-tasks",
    "max_running": 2,
    "approval_hours": 24,
    "heartbeat_min": 30,
    "models": ["haiku", "sonnet", "opus"],
    "budget_default": 20,
    "budget_factor": 1.5,
    "quota_alert": {"five_hour": 0.85, "seven_day_pace": 1.1},
    "sibling_warm_min": 55,
    "sibling_max_ctx": 150000,
    "compact": {"idle_min": 50, "min_ctx": 120000},
    "stuck_min": 40,
    "verify_retries": 2,
    "verify_timeout_min": 20,
    "cloud": {"environment_id": "", "timeout_min": 180}
  },
  "persona": "work",
  "style": "veteran",
  "workdir": "~/work",
  "add_dirs": [
    "~/wiki"
  ],
  "permission_mode": "auto",
  "identity": {
    "owner": "user_no_speak",
    "others": "bot_read_im"
  },
  "context": {
    "enabled": true,
    "max": 20,
    "topic_max": 50,
    "group_window_h": 2,
    "p2p_window_h": 24,
    "max_chars": 400,
    "read_as": "user"
  },
  "ambient": {
    "enabled": true,
    "poll_seconds": 40,
    "quiet_seconds": 25,
    "max_wait_seconds": 180,
    "max_batch": 30,
    "cooldown_min": 10,
    "rotate_turns": 40,
    "command": "/旁听"
  },
  "private": {
    "paths": [
      "~/personal",
      "/\\.private(/|\\b)",
      "~/.claude/projects",
      "~/.claude/history"
    ],
    "search_roots": [
      {
        "root": "~/wiki/wiki",
        "exclude": [
          "**/people/**",
          "**/entities/People*",
          "**/daily/**",
          "**/drafts/**"
        ]
      }
    ]
  },
  "deny_extra": [],
  "chat_max_turns": 60,
  "credential_paths": ["~/.config/codeup", "~/.git-credentials"],
  "prime": true,
  "disable_mcp": true,
  "p2p_idle_hours": 6,
  "group_idle_hours": 2,
  "max_parallel": 3,
  "claude_timeout_min": 40
}
